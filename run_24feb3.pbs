#!/bin/bash
#PBS -N paradis_dt25_train1024_rollloss_b3_r7_pt75_ft75_lr8e-05_24feb
#PBS -q gpu
#PBS -l select=1:ncpus=12:mpiprocs=1:ngpus=1:mem=109G
#PBS -l walltime=12:00:00
#PBS -j n
#PBS -o /space/hall5/sitestore/eccc/mrd/rpnatm/avg000/Toy_Dataset_Shallow_Water/swan/err_out/out/24feb_paradis_dt25_rollloss_b3_r7.out
#PBS -e /space/hall5/sitestore/eccc/mrd/rpnatm/avg000/Toy_Dataset_Shallow_Water/swan/err_out/err/24feb_paradis_dt25_rollloss_b3_r7.err

# IMPORTANT: do NOT use -e (we want "no fail")
set -u -o pipefail

REPO="/space/hall5/sitestore/eccc/mrd/rpnatm/avg000/Toy_Dataset_Shallow_Water/swan"
PY="/home/csu001/data/ppp5/conda_env/paradis/bin/python"

mkdir -p "$REPO/err_out/out" "$REPO/err_out/err"
cd "$REPO"

echo "HOST: $(hostname)"
echo "CWD:  $(pwd)"
echo "PY:   $PY"
echo "TIME: $(date)"
echo "GPU:"
nvidia-smi || true

# =========================
# FIXED SETTINGS
# =========================
MODEL="paradis"
CONFIG="config_paradis.yaml"
SAVE_DIR="trial2_24feb"

# Data / solver
DT_SOLVER=25
NTRAIN=1024
SEED=42

# Checkpoint architecture (MUST match checkpoint)
HD=48
L=8
ENC=3
VEL=12
DIFF=24
REACT=12
BIAS=3

# "pretrain epochs" bookkeeping (checkpoint was trained with pt75)
PT_EPOCHS=0

# Rollout-loss settings
BURN_IN=3
N_ROLLOUT=7

# Finetune controls (requested)
FT_EPOCHS=75
FT_LR="0.00008"

# Pretrain checkpoint to load weights from
PRETRAIN_CKPT="trial_optuna/20260211_paradis_dt30_train1024_pt75_ft0_hd48_L8_enc3_vel12_diff24_react12_bias3_lr3.00e-03_seed42_t00006/version_0/checkpoints/pretrain-epoch=74-val_loss=0.0002.ckpt"

EXP_NAME="${MODEL}_dt${DT_SOLVER}_train${NTRAIN}_rollloss_b${BURN_IN}_r${N_ROLLOUT}_pt${PT_EPOCHS}_hd${HD}_L${L}_enc${ENC}_vel${VEL}_diff${DIFF}_react${REACT}_bias${BIAS}_ft${FT_EPOCHS}_lr${FT_LR}_seed${SEED}_24feb"

LOG_DIR="$REPO/$SAVE_DIR/pbs_logs_24feb"
mkdir -p "$REPO/$SAVE_DIR" "$LOG_DIR"

LOG_FILE="$LOG_DIR/${EXP_NAME}.log"
FAIL_SUMMARY="$LOG_DIR/failures_${EXP_NAME}_$(date +%Y%m%d_%H%M%S)_24feb.txt"
: > "$FAIL_SUMMARY"

echo "============================================================" | tee "$LOG_FILE"
echo "START: $(date)" | tee -a "$LOG_FILE"
echo "MODEL: $MODEL" | tee -a "$LOG_FILE"
echo "CONFIG: $CONFIG" | tee -a "$LOG_FILE"
echo "EXP: $EXP_NAME" | tee -a "$LOG_FILE"
echo "SAVE_DIR: $SAVE_DIR" | tee -a "$LOG_FILE"
echo "dt_solver=$DT_SOLVER  ntrain=$NTRAIN  seed=$SEED" | tee -a "$LOG_FILE"
echo "ARCH: hd=$HD L=$L enc=$ENC vel=$VEL diff=$DIFF react=$REACT bias=$BIAS" | tee -a "$LOG_FILE"
echo "pretrain_epochs(bookkeeping)=$PT_EPOCHS" | tee -a "$LOG_FILE"
echo "pretrain_ckpt=$PRETRAIN_CKPT" | tee -a "$LOG_FILE"
echo "burn_in=$BURN_IN  n_rollout=$N_ROLLOUT  ft_epochs=$FT_EPOCHS  ft_lr=$FT_LR" | tee -a "$LOG_FILE"
echo "============================================================" | tee -a "$LOG_FILE"

# Run (GPU0 of allocation)
CUDA_VISIBLE_DEVICES=0 $PY avi_train_rollout_loss_burnin.py \
  --config "$CONFIG" \
  --experiment.name "$EXP_NAME" \
  --experiment.seed "$SEED" \
  --training.save_dir "$SAVE_DIR" \
  --data.dt_solver "$DT_SOLVER" \
  --data.num_train_examples "$NTRAIN" \
  --training.finetune_epochs "$FT_EPOCHS" \
  --training.finetune_learning_rate "$FT_LR" \
  --model.paradis.hidden_dim "$HD" \
  --model.paradis.num_layers "$L" \
  --model.paradis.num_encoder_layers "$ENC" \
  --model.paradis.num_vels "$VEL" \
  --model.paradis.diffusion_size "$DIFF" \
  --model.paradis.reaction_size "$REACT" \
  --model.paradis.bias_channels "$BIAS" \
  --pretrain_ckpt "$PRETRAIN_CKPT" \
  --burn_in "$BURN_IN" \
  --n_rollout "$N_ROLLOUT" \
  >> "$LOG_FILE" 2>&1

RC=$?

if [[ $RC -ne 0 ]]; then
  echo "[FAIL] $(date) rc=$RC EXP=$EXP_NAME" | tee -a "$LOG_FILE" >> "$FAIL_SUMMARY"
  echo "Command failed, but PBS job will exit cleanly." | tee -a "$LOG_FILE"
else
  echo "[OK]   $(date) rc=0 EXP=$EXP_NAME" | tee -a "$LOG_FILE"
fi

echo "============================================================" | tee -a "$LOG_FILE"
echo "DONE: $(date)  EXP: $EXP_NAME" | tee -a "$LOG_FILE"
echo "Log:  $LOG_FILE" | tee -a "$LOG_FILE"
echo "Fail summary: $FAIL_SUMMARY" | tee -a "$LOG_FILE"
echo "============================================================" | tee -a "$LOG_FILE"

exit 0
