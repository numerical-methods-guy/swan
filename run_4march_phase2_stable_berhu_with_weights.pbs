#!/bin/bash
#PBS -N paradis_gbell_train_gbell_val_all_channel_4march_burn_berhu_with_lat_weights
#PBS -q gpu
#PBS -l select=1:ncpus=12:mpiprocs=1:ngpus=1:mem=109G
#PBS -l walltime=12:00:00
#PBS -j n
#PBS -o /space/hall5/sitestore/eccc/mrd/rpnatm/avg000/Toy_Dataset_Shallow_Water/swan/err_out/out/4march_paradis_gbell_all_channel_burn_berhu_with_lat_weights.out
#PBS -e /space/hall5/sitestore/eccc/mrd/rpnatm/avg000/Toy_Dataset_Shallow_Water/swan/err_out/err/4march_paradis_gbell_all_channel_burn_berhu_with_lat_weights.err

# IMPORTANT: do NOT use -e (we want "no fail")
set -u -o pipefail

REPO="/space/hall5/sitestore/eccc/mrd/rpnatm/avg000/Toy_Dataset_Shallow_Water/swan"
PY="/home/csu001/data/ppp5/conda_env/paradis/bin/python"

mkdir -p "$REPO/err_out/out" "$REPO/err_out/err"
cd "$REPO"

echo "HOST: $(hostname)"
echo "CWD:  $(pwd)"
echo "PY:   $PY"
echo "TIME: $(date)"
echo "GPU:"
nvidia-smi || true

# =========================
# FIXED SETTINGS
# =========================
MODEL="paradis"
CONFIG="config_paradis.yaml"
SAVE_DIR="trial4_4march"

# Script to run
PY_SCRIPT="avi_train_rollout_loss_burnin_all_channel_berhu_with_lat_weights.py"

# Data / solver
DT_SOLVER=25
NTRAIN=1024
SEED=42
PTEP=0
FTEP=100

# Rollout-loss settings
BURN_IN=3
N_ROLLOUT=8

# Architecture (should match init checkpoint)
HD=48
L=8
ENC=3
VEL=6
DIFF=24
REACT=12
BIAS=3
LRATE=0.00005
DELTA=0.75

# Init checkpoint (weights-only init)
INIT_CKPT="trial3_3march/paradis_gbell_train_gbell_val_all_channel_dt25_train1024_hd48_L8_enc3_vel6_diff24_react12_bias3_seed42_lr0.003_3march/version_0/checkpoints/pretrain-epoch=96-val_loss=0.0001.ckpt"

EXP_NAME="${MODEL}_gbell_train_gbell_val_all_channel_rollout_dt${DT_SOLVER}_train${NTRAIN}_hd${HD}_L${L}_enc${ENC}_vel${VEL}_diff${DIFF}_react${REACT}_bias${BIAS}_seed${SEED}_lr${LRATE}_Burn${BURN_IN}_rollout${N_ROLLOUT}_finetune_epochs${FTEP}_delta${DELTA}_4march_berhu_with_lat_weights"

LOG_DIR="$REPO/$SAVE_DIR/pbs_logs_4march_berhu_with_lat_weights"
mkdir -p "$REPO/$SAVE_DIR" "$LOG_DIR"

LOG_FILE="$LOG_DIR/${EXP_NAME}.log"
FAIL_SUMMARY="$LOG_DIR/failures_${EXP_NAME}_$(date +%Y%m%d_%H%M%S)_4march_berhu_with_lat_weights.txt"
: > "$FAIL_SUMMARY"

echo "============================================================" | tee "$LOG_FILE"
echo "START: $(date)" | tee -a "$LOG_FILE"
echo "MODEL: $MODEL" | tee -a "$LOG_FILE"
echo "SCRIPT: $PY_SCRIPT" | tee -a "$LOG_FILE"
echo "CONFIG: $CONFIG" | tee -a "$LOG_FILE"
echo "EXP: $EXP_NAME" | tee -a "$LOG_FILE"
echo "SAVE_DIR: $SAVE_DIR" | tee -a "$LOG_FILE"
echo "dt_solver=$DT_SOLVER  ntrain=$NTRAIN  seed=$SEED" | tee -a "$LOG_FILE"
echo "ARCH: hd=$HD L=$L enc=$ENC vel=$VEL diff=$DIFF react=$REACT bias=$BIAS" | tee -a "$LOG_FILE"
echo "init_ckpt=$INIT_CKPT" | tee -a "$LOG_FILE"
echo "burn_in=$BURN_IN  n_rollout=$N_ROLLOUT  ft_epochs=$FTEP  ft_lr=$LRATE" | tee -a "$LOG_FILE"
echo "============================================================" | tee -a "$LOG_FILE"

# Run (GPU0 of allocation)
CUDA_VISIBLE_DEVICES=0 $PY $PY_SCRIPT \
  --config "$CONFIG" \
  --experiment.name "$EXP_NAME" \
  --experiment.seed "$SEED" \
  --training.save_dir "$SAVE_DIR" \
  --data.dt_solver "$DT_SOLVER" \
  --data.num_train_examples "$NTRAIN" \
  --training.finetune_epochs "$FTEP" \
  --training.finetune_learning_rate "$LRATE" \
  --model.paradis.hidden_dim "$HD" \
  --model.paradis.num_layers "$L" \
  --model.paradis.num_encoder_layers "$ENC" \
  --model.paradis.num_vels "$VEL" \
  --model.paradis.diffusion_size "$DIFF" \
  --model.paradis.reaction_size "$REACT" \
  --model.paradis.bias_channels "$BIAS" \
  --pretrain_ckpt "$INIT_CKPT" \
  --burn_in "$BURN_IN" \
  --n_rollout "$N_ROLLOUT" \
  --loss_delta "$DELTA" \
  >> "$LOG_FILE" 2>&1

RC=$?

if [[ $RC -ne 0 ]]; then
  echo "[FAIL] $(date) rc=$RC EXP=$EXP_NAME" | tee -a "$LOG_FILE" >> "$FAIL_SUMMARY"
  echo "Command failed, but PBS job will exit cleanly." | tee -a "$LOG_FILE"
else
  echo "[OK]   $(date) rc=0 EXP=$EXP_NAME" | tee -a "$LOG_FILE"
fi

echo "============================================================" | tee -a "$LOG_FILE"
echo "DONE: $(date)  EXP: $EXP_NAME" | tee -a "$LOG_FILE"
echo "Log:  $LOG_FILE" | tee -a "$LOG_FILE"
echo "Fail summary: $FAIL_SUMMARY" | tee -a "$LOG_FILE"
echo "============================================================" | tee -a "$LOG_FILE"

exit 0
